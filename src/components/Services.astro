---
import { SITE, INMEDIATO, PAQUETE } from '../data/site';
---

<section id="servicios" class="relative isolate bg-vidalia-beige/40 py-16 sm:py-24">
  <div class="absolute inset-0 -z-10 bg-lienzo opacity-50" aria-hidden="true"></div>
  <div class="mx-auto max-w-7xl px-4">
    <header data-reveal class="mx-auto max-w-2xl text-center">
      <p class="font-script text-2xl text-vidalia-gold">Contigo en cada paso</p>
      <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-vidalia-blue sm:text-4xl">Lo que hacemos por tu familia</h2>
    </header>

    <div data-reveal-stagger class="mt-14 grid items-stretch gap-6 lg:grid-cols-2">
      <article data-spotlight class="flex flex-col rounded-3xl border border-vidalia-gold/40 bg-white p-8 transition duration-300 hover:-translate-y-1 hover:shadow-glow-gold sm:p-10">
        <p class="text-xs font-semibold tracking-[0.2em] text-vidalia-gold uppercase">Cuando lo necesitas hoy</p>
        <h3 class="mt-3 text-2xl font-bold text-vidalia-blue sm:text-3xl">Servicio funerario inmediato</h3>
        <ul data-reveal-stagger class="mt-7 space-y-3.5 text-vidalia-blue/80">
          {INMEDIATO.map((b) => (
            <li class="flex items-start gap-3">
              <i class="ph-fill ph-check-circle mt-0.5 text-lg text-vidalia-gold" aria-hidden="true"></i>
              <span>{b}</span>
            </li>
          ))}
        </ul>
        <div class="mt-auto pt-9">
          <a href={SITE.phoneHref} class="btn w-full bg-vidalia-blue text-white hover:bg-vidalia-deep">
            <i class="ph-bold ph-phone-call" aria-hidden="true"></i>
            Llámanos Ahora
          </a>
        </div>
      </article>

      <article data-spotlight class="flex flex-col rounded-3xl bg-vidalia-blue p-8 text-white shadow-soft ring-2 ring-vidalia-gold transition duration-300 hover:-translate-y-1 hover:shadow-glow-gold sm:p-10">
        <p class="text-xs font-semibold tracking-[0.2em] text-vidalia-gold uppercase">Para dejarlo resuelto</p>
        <h3 class="mt-3 text-2xl font-bold sm:text-3xl">Paquete Vidalia · <span class="text-vidalia-gold">$238 a la quincena</span></h3>
        <ul data-reveal-stagger class="mt-7 space-y-3.5 text-white/85">
          {PAQUETE.map((b) => (
            <li class="flex items-start gap-3">
              <i class="ph-fill ph-check-circle mt-0.5 text-lg text-vidalia-gold" aria-hidden="true"></i>
              <span>{b}</span>
            </li>
          ))}
        </ul>
        <div class="mt-auto pt-9">
          <p class="mb-4 text-center text-sm text-white/65">Total $24,752 · IVA incluido · Hoy pagas solo tu primera quincena</p>
          <a href={SITE.contratarHref} target="_blank" rel="noopener" class="btn w-full bg-vidalia-gold text-white hover:bg-white hover:text-vidalia-blue">
            <i class="ph-bold ph-signature" aria-hidden="true"></i>
            Pide tu paquete en línea
          </a>
        </div>
      </article>
    </div>
  </div>
</section>
