---
import { SITE } from '../data/site';
---

<section id="ubicacion" class="border-t border-vidalia-beige bg-white py-16 sm:py-24">
  <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 lg:grid-cols-[1fr_1.4fr]">
    <header data-reveal>
      <h2 class="flex items-center gap-3 text-3xl font-extrabold tracking-tight text-vidalia-blue sm:text-4xl">
        <i class="ph-fill ph-map-pin text-vidalia-gold" aria-hidden="true"></i> Ubicación
      </h2>
      <span data-filete class="mt-5 block h-0.5 w-20 origin-left rounded-full bg-gradient-to-r from-vidalia-gold to-vidalia-gold/20" aria-hidden="true"></span>
      <p class="mt-6 text-lg leading-relaxed text-vidalia-blue/75">{SITE.address}</p>
      <p class="mt-3 text-vidalia-blue/75">
        Te recibimos las 24 horas · <a href={SITE.phoneHref} class="font-bold whitespace-nowrap text-vidalia-blue hover:text-vidalia-gold">{SITE.phone}</a>
      </p>
      <a href={SITE.mapsHref} target="_blank" rel="noopener" class="btn mt-7 border border-vidalia-gold bg-white text-vidalia-blue hover:bg-vidalia-gold hover:text-white">
        <i class="ph-bold ph-navigation-arrow" aria-hidden="true"></i>
        Cómo llegar
      </a>
    </header>

    <iframe
      data-reveal
      src={SITE.mapsEmbed}
      title="Mapa de Vidalia Funerales Memorables"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="h-72 w-full rounded-3xl border border-vidalia-gold/40 bg-vidalia-beige shadow-soft sm:h-96"
    ></iframe>
  </div>
</section>
