---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown>;
}

const { title, description, schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es-MX" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#202C58" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-192x192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="Vidalia Funerales Memorables" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lobster+Two:ital,wght@1,700&family=Montserrat:wght@400;500;600;700;800&display=swap"
    />
    <script is:inline src="https://unpkg.com/@phosphor-icons/web@2.1.1"></script>

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body class="min-h-dvh pb-20 md:pb-0">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-vidalia-blue focus:px-4 focus:py-2 focus:font-semibold focus:text-white"
    >
      Saltar al contenido
    </a>

    <slot />

    <script is:inline defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script is:inline defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

    <script is:inline>
      // Brillo que sigue al cursor en las tarjetas marcadas con data-spotlight.
      document.addEventListener('pointermove', (e) => {
        const card = e.target.closest?.('[data-spotlight]');
        if (!card) return;
        const r = card.getBoundingClientRect();
        card.style.setProperty('--x', `${e.clientX - r.left}px`);
        card.style.setProperty('--y', `${e.clientY - r.top}px`);
      }, { passive: true });

      document.addEventListener('DOMContentLoaded', () => {
        const root = document.documentElement;
        if (!window.gsap || !window.ScrollTrigger) {
          // Sin GSAP: mostrar todo el contenido.
          root.classList.remove('js');
          return;
        }

        gsap.registerPlugin(ScrollTrigger);
        const mm = gsap.matchMedia();

        mm.add('(prefers-reduced-motion: no-preference)', () => {
          gsap.utils.toArray('[data-reveal]').forEach((el) => {
            gsap.fromTo(
              el,
              { y: 36, opacity: 0 },
              {
                y: 0,
                opacity: 1,
                duration: 0.9,
                ease: 'power3.out',
                clearProps: 'transform',
                scrollTrigger: { trigger: el, start: 'top 88%', once: true },
              },
            );
          });

          gsap.utils.toArray('[data-reveal-stagger]').forEach((group) => {
            gsap.fromTo(
              [...group.children].filter((c) => !c.hasAttribute('data-split')),
              { y: 30, opacity: 0 },
              {
                y: 0,
                opacity: 1,
                duration: 0.8,
                ease: 'power3.out',
                stagger: 0.1,
                clearProps: 'transform',
                scrollTrigger: { trigger: group, start: 'top 88%', once: true },
              },
            );
          });

          // Hero: la fachada se acerca suavemente al cargar y baja más lento que el scroll.
          const heroBg = document.querySelector('[data-hero-bg]');
          if (heroBg) {
            gsap.fromTo(heroBg, { scale: 1.12 }, { scale: 1, duration: 2.6, ease: 'power2.out' });
            gsap.to(heroBg, {
              yPercent: 10,
              ease: 'none',
              scrollTrigger: { trigger: '#inicio', start: 'top top', end: 'bottom top', scrub: true },
            });
          }

          // Titular del hero: se parte en palabras y sube línea por línea desde una máscara.
          // Si el titular trae renglones propios (spans con su peso), se parte cada uno por separado.
          gsap.utils.toArray('[data-split]').forEach((title) => {
            title.setAttribute('aria-label', title.textContent.trim().replace(/\s+/g, ' '));
            const parts = title.children.length ? [...title.children] : [title];
            const inners = parts.flatMap((part) => {
              const words = part.textContent.trim().split(/\s+/);
              part.textContent = '';
              return words.map((w, i) => {
                const mask = document.createElement('span');
                mask.className = 'split-mask';
                mask.setAttribute('aria-hidden', 'true');
                const inner = document.createElement('span');
                inner.className = 'split-word';
                inner.textContent = w;
                mask.append(inner);
                part.append(mask);
                if (i < words.length - 1) part.append(' ');
                return inner;
              });
            });
            title.style.visibility = 'visible';
            // Las palabras de un mismo renglón suben juntas.
            const tops = [...new Set(inners.map((el) => el.parentElement.offsetTop))];
            const lineOf = inners.map((el) => tops.indexOf(el.parentElement.offsetTop));
            gsap.fromTo(
              inners,
              { yPercent: 110 },
              { yPercent: 0, duration: 1.1, ease: 'power3.out', delay: 0.2, stagger: (i) => lineOf[i] * 0.15 },
            );
          });

          // Filetes dorados que se trazan bajo los títulos de sección.
          gsap.utils.toArray('[data-filete]').forEach((line) => {
            gsap.fromTo(
              line,
              { scaleX: 0 },
              {
                scaleX: 1,
                duration: 1.2,
                ease: 'power3.inOut',
                delay: 0.35,
                scrollTrigger: { trigger: line, start: 'top 90%', once: true },
              },
            );
          });

          // Instalaciones: la foto se desliza dentro de su marco al hacer scroll.
          gsap.utils.toArray('[data-parallax]').forEach((layer) => {
            gsap.fromTo(
              layer,
              { yPercent: -6 },
              {
                yPercent: 6,
                ease: 'none',
                scrollTrigger: { trigger: layer.parentElement, start: 'top bottom', end: 'bottom top', scrub: true },
              },
            );
          });

          // Contadores de la franja de confianza.
          gsap.utils.toArray('[data-count]').forEach((el) => {
            const to = parseFloat(el.dataset.count);
            const decimals = parseInt(el.dataset.decimals || '0', 10);
            const obj = { n: 0 };
            gsap.to(obj, {
              n: to,
              duration: 1.6,
              ease: 'power2.out',
              onUpdate: () => { el.textContent = obj.n.toFixed(decimals); },
              scrollTrigger: { trigger: el, start: 'top 90%', once: true },
            });
          });
        });

        window.addEventListener('load', () => ScrollTrigger.refresh());
      });
    </script>
  </body>
</html>
